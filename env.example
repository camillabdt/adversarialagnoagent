# ============================================================
# adversarialagnoagent — environment variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is loaded automatically via python-dotenv (load_dotenv()
# is called at the start of main.py and run_all_models.py).
# Never commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# Groq API
# Used for all models in the automated pipeline:
#   groq/compound-mini, groq/compound,
#   llama-3.1-8b-instant, llama-3.3-70b-versatile,
#   qwen/qwen3-32b,
#   openai/gpt-oss-20b, openai/gpt-oss-120b
#
# Get your key at: https://console.groq.com/keys
# ------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
